# Provider principal: openai | openai-compatible | hermes | mock
AGENT_TEAM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Alternativa para Ollama, vLLM, LocalAI u otro endpoint compatible
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=local
OPENAI_COMPATIBLE_MODEL=qwen3-coder

# Seguridad y servidor
AGENT_TEAM_ALLOWED_ROOT=.
AGENT_TEAM_API_TOKEN=
AGENT_TEAM_HOST=127.0.0.1
AGENT_TEAM_PORT=8008

# Hermes ya debe estar instalado y configurado con `hermes setup`
HERMES_BINARY=hermes
HERMES_TIMEOUT_SECONDS=300

